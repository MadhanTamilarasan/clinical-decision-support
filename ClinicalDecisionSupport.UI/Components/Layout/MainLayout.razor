@inherits LayoutComponentBase
@using ClinicalDecisionSupport.UI.Services
@using ClinicalDecisionSupport.UI.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject UserPersonaService PersonaService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Dashboard | Healware</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar shadow">
                <NavMenu />
            </div>

            <main>
                <div class="top-row">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-plus fs-4 me-2 text-primary"></i>
                        <span class="fw-bold fs-5">Healware <span class="text-primary">Agent</span></span>
                    </div>

                    <div class="d-flex align-items-center">
                        @if (PersonaService.AssignedRole == null)
                        {
                            <div class="dropdown me-3">
                                <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                                    <span class="persona-badge me-2" style="background-color: @PersonaService.GetRoleBadgeColor()">
                                        @PersonaService.CurrentRole
                                    </span>
                                    <span class="d-none d-md-inline">Switch Role</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><h6 class="dropdown-header">Select Persona</h6></li>
                                    <li><button class="dropdown-item" @onclick="() => SetRole(UserRole.Physician)"><i class="bi bi-person-fill me-2"></i> Physician</button></li>
                                    <li><button class="dropdown-item" @onclick="() => SetRole(UserRole.Nurse)"><i class="bi bi-bandaid-fill me-2"></i> Nurse</button></li>
                                    <li><button class="dropdown-item" @onclick="() => SetRole(UserRole.Specialist)"><i class="bi bi-heart-pulse-fill me-2"></i> Specialist</button></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <span class="persona-badge me-3" style="background-color: @PersonaService.GetRoleBadgeColor()">
                                @PersonaService.CurrentRole
                            </span>
                        }

                        <div class="vr me-3"></div>

                        <div class="d-flex align-items-center me-3">
                            <i class="bi bi-person-circle fs-5 me-2"></i>
                            <span class="small fw-medium">@PersonaService.UserName</span>
                        </div>

                        <a href="MicrosoftIdentity/Account/SignOut" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </a>
                    </div>
                </div>

                <article class="content">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        PersonaService.OnRoleChanged += StateHasChanged;

        if (AuthState != null)
        {
            var state = await AuthState;
            PersonaService.InitializeFromClaims(state.User);
        }
    }

    private void SetRole(UserRole role)
    {
        PersonaService.SetRole(role);
    }

    public void Dispose()
    {
        PersonaService.OnRoleChanged -= StateHasChanged;
    }
}
