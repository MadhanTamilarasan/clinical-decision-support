@page "/access-denied"
@layout MainLayout

<PageTitle>Access Denied | ClinicalDS</PageTitle>

<div class="container fade-in py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
                    <h2 class="mt-3 mb-2">Access Denied</h2>
                    <p class="text-muted mb-4">
                        You do not have permission to access this page. Your current role does not include the required privileges.
                    </p>
                    <a href="/" class="btn btn-primary">
                        <i class="bi bi-house-fill me-2"></i>Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
