@page "/referrals"
@using ClinicalDecisionSupport.UI.Models
@using ClinicalDecisionSupport.UI.Services
@attribute [Authorize(Roles = "Specialist")]
@inject UserPersonaService PersonaService
@inject NavigationManager Navigation

<PageTitle>My Referrals | ClinicalDS</PageTitle>

<div class="fade-in">
    <div class="mb-4">
        <h3 class="mb-1">My Referrals</h3>
        <p class="text-muted">Review incoming cases and specialist consult requests.</p>
    </div>

    @if (PersonaService.CurrentRole != UserRole.Specialist)
    {
        <div class="alert alert-warning d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                This view is optimized for <strong>Specialists</strong>. Please switch roles to access consultant tools.
            </div>
        </div>
    }

    <div class="row">
        <div class="col-lg-12">
            <div class="medical-card">
                <div class="medical-card-header">
                    <h5 class="mb-0">Incoming Consultations</h5>
                    <span class="badge bg-primary">2 Pending</span>
                </div>
                <div class="medical-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Patient</th>
                                    <th>Referring MD</th>
                                    <th>Urgency</th>
                                    <th>Reason</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">Robert Miller</div>
                                        <div class="small text-muted">ID: patient-789</div>
                                    </td>
                                    <td>Dr. Sarah Johnson</td>
                                    <td><span class="badge bg-danger">Urgent</span></td>
                                    <td>Follow-up on STEMI assessment</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary me-2">Review Case</button>
                                        <button class="btn btn-sm btn-primary">Accept</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">Linda Garcia</div>
                                        <div class="small text-muted">ID: patient-101</div>
                                    </td>
                                    <td>Dr. James Chen</td>
                                    <td><span class="badge bg-warning text-dark">Routine</span></td>
                                    <td>Cardiology consult for arrhythmia</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary me-2">Review Case</button>
                                        <button class="btn btn-sm btn-primary">Accept</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        PersonaService.OnRoleChanged += StateHasChanged;
    }
}
